---
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import AnnouncementBar from "@/components/AnnouncementBar.astro";
import CartCelebration from "@/components/CartCelebration";
import { collectionPath } from "@/lib/collections";
import { listCollections } from "@/lib/medusa";
import SocialMeta from "@/components/SocialMeta.astro";
import { site } from "@/lib/site";
import { DEFAULT_GOOGLE_FONTS_HREF } from "@/lib/collectionThemes";
import { defaultOgImageUrlVersioned } from "@/lib/og/socialUrl";
import "@/styles/global.css";

let shopCollections: { href: string; label: string; handle: string }[] = [];
try {
  const { collections } = await listCollections();
  shopCollections = collections
    .slice()
    .sort((a, b) => a.title.localeCompare(b.title))
    .map((c) => ({
      href: collectionPath(c.handle),
      label: c.title,
      handle: c.handle,
    }));
} catch {}

interface Props {
  title?: string
  description?: string
  image?: string
  imageAlt?: string
  noIndex?: boolean
  googleFontsHref?: string
  themeColor?: string
  /** Canonical URL without tracking/query params (defaults to pathname). */
  canonicalHref?: string
}

const {
  title,
  description = site.description,
  image = defaultOgImageUrlVersioned(),
  imageAlt,
  noIndex = false,
  googleFontsHref = DEFAULT_GOOGLE_FONTS_HREF,
  themeColor = "#1a1524",
  canonicalHref,
} = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;
const canonicalUrl = canonicalHref ?? new URL(Astro.url.pathname, site.url).href;
const ogImage = image.startsWith("http") ? image : new URL(image, site.url).href;
const ogImageAlt = imageAlt ?? `${site.name} — ${site.tagline}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={googleFontsHref} rel="stylesheet" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noIndex && <meta name="robots" content="noindex,nofollow" />}
  <SocialMeta
    pageTitle={pageTitle}
    description={description}
    canonicalUrl={canonicalUrl}
    image={ogImage}
    imageAlt={ogImageAlt}
  />
  <meta name="theme-color" content={themeColor} />
</head>
<body class="min-h-screen bg-paper text-ink antialiased font-sans">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[200] focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink focus:text-sm focus:uppercase focus:tracking-widest"
  >
    Skip to content
  </a>
  <div class="mx-auto flex min-h-screen w-full flex-col">
    <AnnouncementBar />
    <Nav collections={shopCollections} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer collections={shopCollections} />
  </div>
  <CartCelebration client:load />
</body>
</html>
