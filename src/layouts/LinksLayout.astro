---
import SiteHeader from "@/components/SiteHeader.astro";
import SocialMeta from "@/components/SocialMeta.astro";
import CartCelebration from "@/components/CartCelebration";
import { ogImageAbsoluteUrl, OG_LINKS_PATH } from "@/lib/og/urls";
import { site } from "@/lib/site";
import { DEFAULT_GOOGLE_FONTS_HREF } from "@/lib/collectionThemes";
import "@/styles/global.css";
import "@/styles/link-in-bio.css";

interface Props {
  title?: string
  description?: string
  canonicalHref?: string
}

const {
  title = "Links",
  description = "Shop Floof — witty SW Florida goods. Dogs, reads, desk, and more.",
  canonicalHref,
} = Astro.props;

const pageTitle = `${title} | ${site.name}`;
const canonicalUrl =
  canonicalHref ?? new URL("/links", site.url).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={DEFAULT_GOOGLE_FONTS_HREF} rel="stylesheet" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <SocialMeta
    pageTitle={pageTitle}
    description={description}
    canonicalUrl={canonicalUrl}
    image={ogImageAbsoluteUrl(OG_LINKS_PATH)}
    imageAlt="Floof link in bio — shop Dogs, Reads, Desk and new drops"
  />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#1a1524" />
</head>
<body class="min-h-screen bg-paper text-ink antialiased font-sans link-in-bio-page">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[200] focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-ink focus:text-sm focus:uppercase focus:tracking-widest"
  >
    Skip to content
  </a>
  <div class="mx-auto flex min-h-screen w-full flex-col">
    <SiteHeader />
    <main id="main-content" class="flex-1 w-full max-w-lg mx-auto px-4 pb-10">
      <slot />
    </main>
    <footer class="border-t-[3px] border-ink py-6 text-center text-[0.65rem] uppercase tracking-[0.14em] text-ink-2">
      <a href="/" class="hover:text-accent transition-colors">{site.name}</a>
      <span class="mx-2 opacity-40">·</span>
      <span>{site.location}</span>
    </footer>
  </div>
  <CartCelebration client:load />
</body>
</html>
