---
import Icon from "@/components/Icon.astro"
---
<div class="bg-ink text-paper text-center text-xs sm:text-sm py-2.5 px-4 border-b-[3px] border-ink">
  <p class="font-medium tracking-[0.08em] uppercase inline-flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
    <Icon name="star" class="w-3.5 h-3.5 text-accent shrink-0" />
    <span>Free shipping over $75</span>
    <span class="text-paper/30 hidden sm:inline">·</span>
    <span class="hidden sm:inline">Made to order · ships from the US</span>
    <span class="text-paper/30 hidden sm:inline">·</span>
    <a href="/shipping-returns" class="underline underline-offset-2 text-accent hover:text-paper hidden sm:inline">
      30-day returns
    </a>
  </p>
</div>
