---
const currentYear = new Date().getFullYear();
const shopLinks = [
  { href: "/store", label: "All Products" },
  { href: "/store?cat=tees", label: "T-Shirts" },
  { href: "/store?cat=hoodies", label: "Hoodies" },
  { href: "/checkout", label: "Cart & Checkout" },
];
const infoLinks = [
  { href: "/about", label: "About Floof" },
  { href: "/shipping-returns", label: "Shipping & Returns" },
  { href: "/contact", label: "Contact Us" },
  { href: "/privacy", label: "Privacy Policy" },
  { href: "/terms", label: "Terms of Service" },
];
---
{/* Hallmark · footer: Ft5 statement · risograph */}
<footer class="mt-auto border-t-[3px] border-ink bg-paper-2">
  <div class="mx-auto max-w-7xl px-5 md:px-6 py-14 md:py-16">
    <div class="max-w-2xl border-[3px] border-ink bg-paper p-6 md:p-8">
      <a href="/" class="font-display text-3xl md:text-4xl tracking-tight text-ink inline-block">
        Floof
      </a>
      <p class="mt-5 font-display text-2xl md:text-3xl leading-[1.05] text-ink">
        Soft blanks. Sharp wit.<br class="hidden sm:block" />
        <span class="text-accent">Printed when you order.</span>
      </p>
      <p class="mt-4 text-sm text-ink-2 leading-relaxed max-w-md">
        Witty apparel from Southwest Florida — small drops, soft blanks, made to order.
      </p>
    </div>

    <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      <nav aria-label="Shop">
        <p class="eyebrow">Shop</p>
        <ul class="mt-4 space-y-2.5">
          {shopLinks.map((l) => (
            <li>
              <a href={l.href} class="text-sm text-ink-2 hover:text-accent transition-colors">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Help">
        <p class="eyebrow">Help</p>
        <ul class="mt-4 space-y-2.5">
          {infoLinks.map((l) => (
            <li>
              <a href={l.href} class="text-sm text-ink-2 hover:text-accent transition-colors">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div>
        <p class="eyebrow">Stay in the loop</p>
        <p class="mt-4 text-sm text-ink-2">Early word on new drops and limited pieces.</p>
        <form class="mt-4 flex flex-wrap gap-0" action="/contact" method="get" aria-label="Newsletter signup">
          <label for="footer-email" class="sr-only">Email</label>
          <input
            id="footer-email"
            type="email"
            name="email"
            required
            placeholder="you@email.com"
            class="min-w-0 flex-1 border-[3px] border-ink bg-paper px-4 py-2.5 text-sm text-ink placeholder:text-muted focus:outline-none focus:border-accent"
          />
          <button type="submit" class="btn btn--sm shrink-0 !border-l-0">
            Join
          </button>
        </form>
        <p class="mt-2 text-[11px] text-muted">No spam. Unsubscribe anytime.</p>
      </div>
    </div>

    <div class="mt-14 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-t-[3px] border-ink pt-8">
      <p class="text-xs font-medium tracking-[0.1em] uppercase text-muted">&copy; {currentYear} Floof. Made in SW Florida.</p>
      <p class="text-xs text-muted">
        Fulfilled by <a href="https://www.printful.com" target="_blank" rel="noopener noreferrer" class="text-secondary underline hover:text-accent">Printful</a>
        &middot; Payments by <a href="https://stripe.com" target="_blank" rel="noopener noreferrer" class="text-secondary underline hover:text-accent">Stripe</a>
      </p>
    </div>
  </div>
</footer>
