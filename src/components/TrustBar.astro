---
import Icon from "@/components/Icon.astro"

interface Props {
  compact?: boolean
}
const { compact = false } = Astro.props
const items: { icon: string; title: string; body: string }[] = [
  { icon: "truck", title: "Ships from the US", body: "Print-on-demand — made when you order" },
  { icon: "lock", title: "Secure checkout", body: "Card payments powered by Stripe" },
  { icon: "return", title: "Easy returns", body: "30 days on unworn items" },
  { icon: "palm", title: "SWFL brand", body: "Designed on the Gulf Coast" },
]
---
<section class:list={["border-y-[3px] border-ink bg-paper-2", compact ? "py-5" : "py-8"]}>
  <div class="mx-auto max-w-7xl px-5 md:px-6">
    <div class="grid grid-cols-2 gap-0 lg:grid-cols-4 border-[3px] border-ink">
      {items.map((item, i) => (
        <div class:list={[
          "flex flex-col sm:flex-row sm:items-start gap-2 sm:gap-3 p-4 md:p-5 text-center sm:text-left",
          i < items.length - 1 && "border-b-[3px] lg:border-b-0 lg:border-r-[3px] border-ink",
          i === 1 && "border-b-[3px] lg:border-b-0 border-ink",
        ]}>
          <span
            class="inline-flex h-10 w-10 mx-auto sm:mx-0 shrink-0 items-center justify-center border-[3px] border-ink bg-accent text-accent-ink"
            role="img"
            aria-label={item.title}
          >
            <Icon name={item.icon} class="w-5 h-5" />
          </span>
          <div>
            <p class="text-sm font-semibold text-ink uppercase tracking-wide">{item.title}</p>
            <p class="mt-0.5 text-xs text-ink-2 leading-relaxed">{item.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
