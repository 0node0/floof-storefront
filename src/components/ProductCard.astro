---
import type { FloofProduct } from "@/lib/product"
import { colorMap, categoryLabels } from "@/lib/product"

interface Props {
  product: FloofProduct
  priority?: boolean
  index?: number
}
const { product, priority = false, index } = Astro.props
const catLabel = categoryLabels[product.category] || product.category
const idx = typeof index === "number" ? String(index + 1).padStart(2, "0") : null
---
<a
  href={`/products/${product.slug}`}
  class="card-surface group block overflow-hidden"
>
  <div class="relative aspect-square overflow-hidden bg-cream p-5 sm:p-6 flex items-center justify-center border-b-[3px] border-ink">
    {idx && (
      <span class="absolute top-0 left-0 z-10 px-2 py-1 text-[0.65rem] font-semibold tracking-[0.1em] bg-paper text-accent border-r-[3px] border-b-[3px] border-ink">
        {idx}
      </span>
    )}
    {product.isWip && (
      <span class="absolute top-0 right-0 z-10 px-2 py-1 text-[0.65rem] font-semibold tracking-[0.1em] uppercase bg-accent text-accent-ink border-l-[3px] border-b-[3px] border-ink">
        Preview
      </span>
    )}
    {product.image ? (
      <img
        src={product.image}
        alt={`${product.name} — Floof apparel`}
        class="w-full h-full object-contain group-hover:scale-[1.04] transition-transform duration-300"
        loading={priority ? "eager" : "lazy"}
        width="400"
        height="400"
      />
    ) : (
      <span class="font-display text-2xl md:text-3xl text-paper leading-tight text-center px-2">
        {product.phrase}
      </span>
    )}
  </div>
  <div class="p-4 md:p-5">
    <p class="eyebrow">{catLabel}</p>
    <h3 class="mt-1.5 font-display text-lg text-ink group-hover:text-accent transition-colors line-clamp-2">
      {product.name}
    </h3>
    <p class="mt-1 text-sm text-ink-2 line-clamp-2 normal-case tracking-normal font-normal font-sans">
      {product.description}
    </p>
    <div class="mt-3 flex items-center justify-between gap-2 border-t border-ink/15 pt-3">
      <div>
        <span class="text-base font-semibold text-accent tabular-nums">${product.price.toFixed(2)}</span>
        {product.sizes.length > 0 && (
          <p class="text-[11px] font-mono text-muted mt-0.5">
            {product.sizes[0]}–{product.sizes[product.sizes.length - 1]}
          </p>
        )}
      </div>
      {product.colors.length > 0 && (
        <div class="flex gap-1 items-center" aria-label={`${product.colors.length} colors`}>
          {product.colors.slice(0, 5).map((color) => (
            <span
              class="inline-block w-3.5 h-3.5 border border-ink/40"
              style={`background: ${colorMap[color] || "#888"}`}
              title={color}
            />
          ))}
        </div>
      )}
    </div>
  </div>
</a>
