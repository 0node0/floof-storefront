---
import type { ThemeAwareHeroCopy } from "@/lib/themeHeroCopy"
import type { ThemeHeroAssets } from "@/lib/collectionThemes"
import { floridaFloofStaticArtByAnimal } from "@/lib/floridaFloofStickerArt"
import type { FloridaFloofAnimalSlug } from "@/lib/floridaFloofs"

interface Props {
  hero: ThemeAwareHeroCopy
  assets: ThemeHeroAssets
  productCount?: number
}

const { hero, productCount = 0 } = Astro.props
const assetBase = "/collections/florida-floofs"

const primaryLabel =
  productCount > 0 ? `Shop all ${productCount}` : "Meet the natives"
const primaryHref = productCount > 0 ? "#collection-grid" : "#animal-filters"

const stripLede =
  "Twelve Gulf-coast natives in flower crowns. Stickers, tees and mugs."

/** Strip order tuned for visual rhythm (matches option D mock). */
const STRIP_ANIMALS: FloridaFloofAnimalSlug[] = [
  "roseate-spoonbill",
  "manatee",
  "florida-panther",
  "loggerhead",
  "brown-pelican",
  "bottlenose-dolphin",
  "alligator",
  "sandhill-crane",
  "snowy-egret",
  "burrowing-owl",
  "gopher-tortoise",
  "river-otter",
]

const STRIP_ROTATIONS = [-7, 5, -4, 6, -5, 4, -6, 3, -3, 5, -4, 6]
---
<section
  class="collection-hero collection-hero--florida-floofs collection-hero--florida-floofs-d"
  data-hero-variant="floridaFloofs"
  aria-labelledby="collection-hero-title"
>
  <div class="collection-hero--florida-floofs__inner">
    <header class="collection-hero--florida-floofs__top">
      <p class="collection-hero--florida-floofs__eyebrow">
        <img src={`${assetBase}/palm-doodle.svg`} alt="" width="22" height="28" aria-hidden="true" />
        {hero.eyebrow ?? "Gulf-coast natives"}
      </p>

      <div class="collection-hero--florida-floofs__headline-row">
        <h1 id="collection-hero-title" class="collection-hero--florida-floofs__title">
          {hero.titleAccent ? (
            <>
              {hero.title}{" "}
              <em>{hero.titleAccent}</em>
            </>
          ) : (
            hero.title
          )}
        </h1>

        <div class="collection-hero--florida-floofs__aside">
          <p class="collection-hero--florida-floofs__lede">{stripLede}</p>
          <div class="collection-hero--florida-floofs__btns">
            <a class="collection-hero--florida-floofs__btn collection-hero--florida-floofs__btn--shop" href={primaryHref}>
              {primaryLabel}
            </a>
            {productCount > 0 && (
              <a class="collection-hero--florida-floofs__btn collection-hero--florida-floofs__btn--alt" href="#animal-filters">
                Shop by animal
              </a>
            )}
          </div>
        </div>
      </div>
    </header>

    <div class="collection-hero--florida-floofs__strip-outer">
      <div class="collection-hero--florida-floofs__strip-fade collection-hero--florida-floofs__strip-fade--left" aria-hidden="true"></div>
      <div class="collection-hero--florida-floofs__strip-fade collection-hero--florida-floofs__strip-fade--right" aria-hidden="true"></div>
      <ul class="collection-hero--florida-floofs__strip" role="list" aria-hidden="true">
        {STRIP_ANIMALS.map((slug, i) => (
          <li
            class="collection-hero--florida-floofs__strip-item"
            style={`--strip-rotate: ${STRIP_ROTATIONS[i % STRIP_ROTATIONS.length]}deg`}
          >
            <img
              src={floridaFloofStaticArtByAnimal(slug)}
              alt=""
              width="200"
              height="200"
              loading={i < 4 ? "eager" : "lazy"}
              decoding="async"
            />
          </li>
        ))}
      </ul>
      <p class="collection-hero--florida-floofs__strip-hint" aria-hidden="true">
        <span>←</span> Drag to meet the locals <span>→</span>
      </p>
    </div>
  </div>
</section>
