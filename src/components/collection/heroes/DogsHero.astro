---
import CollectionHeroImage from "../CollectionHeroImage.astro"
import type { CollectionHeroCopy } from "@/lib/collectionHero"
import type { ThemeHeroAssets } from "@/lib/collectionThemes"

interface Props {
  hero: CollectionHeroCopy
  assets: ThemeHeroAssets
}

const { hero, assets } = Astro.props
---
<section
  class="collection-hero collection-hero--dogs"
  data-hero-variant="dogs"
  aria-labelledby="collection-hero-title"
>
  <div class="collection-hero--dogs__paw-trail" aria-hidden="true">
    {Array.from({ length: 9 }).map((_, i) => (
      <span class="collection-hero--dogs__paw" style={`--i: ${i}`}>
        <img src="/collections/shared/paw.svg" alt="" width="28" height="28" />
      </span>
    ))}
  </div>

  <div class="mx-auto max-w-7xl px-5 md:px-6 py-10 md:py-14 lg:py-16">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6 relative z-[1]">
        <p class="collection-hero--dogs__eyebrow eyebrow">Good dogs club · {hero.handle}</p>
        <h1
          id="collection-hero-title"
          class="mt-3 font-display text-4xl md:text-5xl lg:text-[3.25rem] text-ink leading-[1.02]"
        >
          {hero.title}
        </h1>
        <p class="mt-4 text-ink-2 text-base md:text-lg max-w-md normal-case tracking-normal font-normal leading-relaxed">
          {hero.tagline}
        </p>
        <div class="collection-hero--dogs__note" role="note">
          <span class="collection-hero--dogs__note-pin" aria-hidden="true" />
          <p class="collection-handwriting">Tail wags sold separately.</p>
        </div>
      </div>

      <div class="lg:col-span-6 relative flex justify-center lg:justify-end">
        <figure class="collection-hero--dogs__polaroid">
          <div class="collection-hero--dogs__polaroid-frame">
            <CollectionHeroImage
              basePath={assets.imageBase}
              alt={assets.imageAlt}
              priority
              class="collection-hero--dogs__polaroid-photo"
            />
          </div>
          <figcaption class="collection-handwriting collection-hero--dogs__polaroid-cap">
            certified good boy · {new Date().getFullYear()}
          </figcaption>
        </figure>
        <div class="collection-hero--dogs__doxie" aria-hidden="true">
          <img
            src="/collections/dogs/dachshund.svg"
            alt=""
            width="120"
            height="72"
            class="collection-hero--dogs__doxie-img"
          />
        </div>
      </div>
    </div>
  </div>
</section>
