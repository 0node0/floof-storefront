---
import CollectionHeroImage from "../CollectionHeroImage.astro"
import type { ThemeAwareHeroCopy } from "@/lib/themeHeroCopy"
import type { ThemeHeroAssets } from "@/lib/collectionThemes"

interface Props {
  hero: ThemeAwareHeroCopy
  assets: ThemeHeroAssets
}

const { hero, assets } = Astro.props
const base = "/collections/reads"
---
<section
  class="collection-hero collection-hero--reads"
  data-hero-variant="reads"
  aria-labelledby="collection-hero-title"
>
  <div class="collection-hero--reads__inner">
    <div class="collection-hero--reads__page">
      <span class="collection-hero--reads__fold" aria-hidden="true"></span>
      <div class="collection-hero--reads__kick">
        <span>The reading room</span>
        <span>Vol. 01</span>
      </div>
      <img
        class="collection-hero--reads__margin"
        src={`${base}/marginalia-bracket.svg`}
        alt=""
        width="48"
        height="120"
        aria-hidden="true"
      />
      <p class="collection-handwriting collection-hero--reads__mnote" aria-hidden="true">
        guilty, every single page
      </p>
      <h1 id="collection-hero-title" class="collection-hero--reads__title">
        {hero.titleAccent ? (
          <>
            {hero.title}{" "}
            <em>
              {hero.titleAccent}
              <img src={`${base}/scribble-underline.svg`} alt="" width="280" height="20" aria-hidden="true" />
            </em>
          </>
        ) : (
          hero.title
        )}
      </h1>
      <p class="collection-hero--reads__lede">{hero.tagline}</p>
      <div class="collection-hero--reads__btns">
        <a class="collection-hero--reads__btn" href="#collection-grid">Browse the shelf</a>
        <a class="collection-hero--reads__lnk" href="#collection-grid">Six pieces, printed to order</a>
      </div>
      <img
        class="collection-hero--reads__ring"
        src={`${base}/coffee-ring.svg`}
        alt=""
        width="160"
        height="160"
        aria-hidden="true"
      />
    </div>

    <figure class="collection-hero--reads__plate">
      <div class="collection-hero--reads__stamp" aria-hidden="true">
        <img src={`${base}/due-stamp.svg`} alt="" width="120" height="120" />
        <div>
          <b>DUE BACK</b>
          <strong>OCT 27</strong>
        </div>
      </div>
      <div class="collection-hero--reads__img-wrap">
        <span class="collection-hero--reads__corner collection-hero--reads__corner--tl" aria-hidden="true"></span>
        <span class="collection-hero--reads__corner collection-hero--reads__corner--br" aria-hidden="true"></span>
        <CollectionHeroImage
          basePath={assets.imageBase}
          alt={assets.imageAlt}
          priority
          class="collection-hero--reads__photo"
        />
      </div>
      <figcaption>
        <span>Plate I</span>
        Bookmark: Whatever Was Nearest Mug, $23.99
      </figcaption>
      <div class="collection-hero--reads__pocket" aria-hidden="true">
        <div class="collection-hero--reads__pocket-card">
          <img src={`${base}/library-card.svg`} alt="" width="200" height="120" />
          <div class="collection-hero--reads__pocket-lines">
            <span class="t">Date due</span>
            SEP 02<br />SEP 30<br />OCT 27 <span class="s">renewed</span><br />NOV 24
          </div>
        </div>
        <img class="collection-hero--reads__pocket-sleeve" src={`${base}/card-pocket.svg`} alt="" width="220" height="80" />
      </div>
    </figure>
  </div>
</section>
<div class="collection-hero--reads__rule">
  <img src={`${base}/fleuron.svg`} alt="" width="48" height="24" aria-hidden="true" />
</div>
