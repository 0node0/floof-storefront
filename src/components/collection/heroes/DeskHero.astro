---
import CollectionHeroImage from "../CollectionHeroImage.astro"
import DeskMuteCoffee from "../DeskMuteCoffee"
import type { CollectionHeroCopy } from "@/lib/collectionHero"
import type { ThemeHeroAssets } from "@/lib/collectionThemes"

interface Props {
  hero: CollectionHeroCopy
  assets: ThemeHeroAssets
}

const { hero, assets } = Astro.props
const month = new Date().toLocaleString("en-US", { month: "short" }).toUpperCase()
const day = new Date().getDate()
---
<section
  class="collection-hero collection-hero--desk"
  data-hero-variant="desk"
  aria-labelledby="collection-hero-title"
>
  <div class="mx-auto max-w-7xl px-5 md:px-6 py-10 md:py-14">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-10 items-start">
      <div class="lg:col-span-6 space-y-5">
        <div class="flex flex-wrap items-start gap-3">
          <div class="collection-hero--desk__sticky collection-hero--desk__sticky--yellow" role="note">
            <p class="collection-handwriting text-sm leading-snug">camera off<br />brain on</p>
          </div>
          <DeskMuteCoffee client:visible />
          <div class="collection-hero--desk__calendar" aria-label="Calendar">
            <p class="collection-hero--desk__calendar-month">{month}</p>
            <p class="collection-hero--desk__calendar-day">{day}</p>
            <p class="collection-hero--desk__calendar-note">standup?</p>
          </div>
        </div>

        <div class="collection-hero--desk__notepad">
          <p class="collection-hero--desk__notepad-label eyebrow">WFH field notes</p>
          <h1
            id="collection-hero-title"
            class="mt-2 font-display text-4xl md:text-5xl text-ink leading-[1.05]"
          >
            {hero.title}
          </h1>
          <p class="mt-3 text-ink-2 text-base md:text-lg max-w-lg leading-relaxed font-normal">
            {hero.tagline}
          </p>
        </div>
      </div>

      <div class="lg:col-span-6">
        <figure class="collection-hero--desk__monitor">
          <div class="collection-hero--desk__monitor-bar" aria-hidden="true">
            <span /><span /><span />
          </div>
          <CollectionHeroImage
            basePath={assets.imageBase}
            alt={assets.imageAlt}
            priority
            class="collection-hero--desk__monitor-screen"
          />
        </figure>
      </div>
    </div>
  </div>
</section>
