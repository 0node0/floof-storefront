---
import { FLORIDA_FLOOF_ANIMALS } from "@/lib/floridaFloofs"
import { floridaFloofStaticArtByAnimal } from "@/lib/floridaFloofStickerArt"

const assetBase = "/collections/florida-floofs"
---
<section id="animal-filters" class="florida-floofs-teaser" aria-labelledby="florida-teaser-title">
  <div class="florida-floofs-teaser__head">
    <img src={`${assetBase}/wave-doodle.svg`} alt="" width="80" height="16" aria-hidden="true" />
    <h2 id="florida-teaser-title" class="font-display text-2xl md:text-3xl text-ink">
      Twelve natives, landing soon
    </h2>
    <p class="mt-3 text-ink-2 max-w-lg mx-auto normal-case tracking-normal font-normal text-sm md:text-base">
      Stickers, tees and mugs are rolling onto the press. Each floof wears a flower crown — browse the art while the shop catches up.
    </p>
  </div>
  <ul class="florida-floofs-teaser__grid">
    {FLORIDA_FLOOF_ANIMALS.map((animal) => (
      <li class="florida-floofs-teaser__tile">
        <div class="florida-floofs-teaser__art">
          <img
            src={floridaFloofStaticArtByAnimal(animal.slug)}
            alt={`${animal.label} flower-crown sticker art`}
            width="200"
            height="200"
            loading="lazy"
          />
        </div>
        <p class="florida-floofs-teaser__label">{animal.label}</p>
        <span class="florida-floofs-teaser__soon">Coming soon</span>
      </li>
    ))}
  </ul>
</section>
