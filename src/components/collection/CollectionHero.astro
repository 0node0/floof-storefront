---
import type { ThemeAwareHeroCopy } from "@/lib/themeHeroCopy"
import type { HeroVariant, ThemeHeroAssets } from "@/lib/collectionThemes"
import FloofHero from "./heroes/FloofHero.astro"
import DogsHero from "./heroes/DogsHero.astro"
import ReadsHero from "./heroes/ReadsHero.astro"
import DeskHero from "./heroes/DeskHero.astro"
import FloridaFloofsHero from "./heroes/FloridaFloofsHero.astro"

interface Props {
  variant: HeroVariant
  hero: ThemeAwareHeroCopy
  assets: ThemeHeroAssets
  productCount?: number
}

const { variant, hero, assets, productCount = 0 } = Astro.props
---
{
  variant === "dogs" ? (
    <DogsHero hero={hero} assets={assets} productCount={productCount} />
  ) : variant === "reads" ? (
    <ReadsHero hero={hero} assets={assets} productCount={productCount} />
  ) : variant === "desk" ? (
    <DeskHero hero={hero} assets={assets} productCount={productCount} />
  ) : variant === "floridaFloofs" ? (
    <FloridaFloofsHero hero={hero} assets={assets} productCount={productCount} />
  ) : (
    <FloofHero hero={hero} />
  )
}
