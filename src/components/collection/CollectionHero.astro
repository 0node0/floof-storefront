---
import type { CollectionHeroCopy } from "@/lib/collectionHero"
import type { HeroVariant, ThemeHeroAssets } from "@/lib/collectionThemes"
import FloofHero from "./heroes/FloofHero.astro"
import DogsHero from "./heroes/DogsHero.astro"
import ReadsHero from "./heroes/ReadsHero.astro"
import DeskHero from "./heroes/DeskHero.astro"

export type { CollectionHeroCopy }

interface Props {
  variant: HeroVariant
  hero: CollectionHeroCopy
  assets: ThemeHeroAssets
}

const { variant, hero, assets } = Astro.props
---
{
  variant === "dogs" ? (
    <DogsHero hero={hero} assets={assets} />
  ) : variant === "reads" ? (
    <ReadsHero hero={hero} assets={assets} />
  ) : variant === "desk" ? (
    <DeskHero hero={hero} assets={assets} />
  ) : (
    <FloofHero hero={hero} />
  )
}
