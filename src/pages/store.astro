---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/ProductCard.astro";
import TrustBar from "@/components/TrustBar.astro";
import { collectionPath } from "@/lib/collections";
import { listCollections, listProducts } from "@/lib/medusa";
import {
  categoryLabels,
  mapProduct,
  productTypeOrder,
  sortFloofProducts,
  type FloofProduct,
} from "@/lib/product";
import { ogImageAbsoluteUrl, OG_STORE_PATH } from "@/lib/og/urls";

export const prerender = false;

const collectionParam = Astro.url.searchParams.get("collection") || "all";
const catParam = Astro.url.searchParams.get("cat") || "all";
const sortParam = Astro.url.searchParams.get("sort") || "featured";

let all: FloofProduct[] = [];
let medusaCollections: { handle: string; title: string }[] = [];
try {
  const { products } = await listProducts();
  all = products.map(mapProduct);
} catch {}
try {
  const { collections } = await listCollections();
  medusaCollections = collections
    .slice()
    .sort((a, b) => a.title.localeCompare(b.title))
    .map((c) => ({ handle: c.handle, title: c.title }));
} catch {}

const productTypes = productTypeOrder.filter((id) =>
  all.some((p) => p.category === id)
);

const collectionFilters = [
  { id: "all", label: "All collections" },
  ...medusaCollections.map((c) => ({ id: c.handle, label: c.title })),
].filter(
  (c) =>
    c.id === "all" ||
    all.some((p) => p.collectionHandle === c.id)
);

function storeHref(opts: {
  collection?: string;
  cat?: string;
  sort?: string;
}): string {
  const params = new URLSearchParams();
  const col = opts.collection ?? collectionParam;
  const cat = opts.cat ?? catParam;
  const sort = opts.sort ?? sortParam;
  if (col !== "all") params.set("collection", col);
  if (cat !== "all") params.set("cat", cat);
  if (sort !== "featured") params.set("sort", sort);
  const q = params.toString();
  return q ? `/store?${q}` : "/store";
}

let filtered = all;
if (collectionParam !== "all") {
  filtered = filtered.filter((p) => p.collectionHandle === collectionParam);
}
if (catParam !== "all") {
  filtered = filtered.filter((p) => p.category === catParam);
}
filtered = sortFloofProducts(filtered, sortParam);

const activeCollection = medusaCollections.find(
  (c) => c.handle === collectionParam
);
const pageTitle =
  activeCollection && collectionParam !== "all"
    ? activeCollection.title
    : catParam !== "all"
      ? categoryLabels[catParam] || "Shop"
      : "Shop";

const countLabel =
  filtered.length === 1 ? "1 piece" : `${filtered.length} pieces`;
---
<Layout
  title={pageTitle}
  description="Browse Floof tees, hoodies, mugs, stickers, and more — witty SW Florida goods, printed fresh when you order."
  image={ogImageAbsoluteUrl(OG_STORE_PATH)}
  imageAlt="Shop all Floof mugs, stickers, tees and hoodies"
>
  <section class="page-band">
    <div class="mx-auto max-w-7xl px-5 md:px-6 py-12 md:py-16">
      <p class="eyebrow">Shop · inventory</p>
      <h1 class="mt-2 font-display text-4xl md:text-5xl text-ink">
        The Collection
      </h1>
      <p class="mt-3 text-ink-2 text-sm md:text-base max-w-xl normal-case tracking-normal font-normal">
        Soft blanks, sharp wit. Pick a size — we print it fresh.
      </p>
    </div>
  </section>

  <TrustBar compact />

  {all.length === 0 && (
    <div class="mx-auto max-w-2xl px-6 py-20 text-center">
      <p class="font-display text-2xl text-ink">No products yet</p>
      <p class="mt-3 text-ink-2 normal-case tracking-normal font-normal">Check back soon — new drops are on the way.</p>
    </div>
  )}

  {all.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 md:px-6 py-10 md:py-12">
      <div class="flex flex-col gap-6 border-b-[3px] border-ink pb-6">
        <div>
          <p class="text-[0.65rem] font-semibold tracking-[0.14em] uppercase text-muted mb-2">
            Category
          </p>
          <div class="flex flex-wrap gap-2" role="tablist" aria-label="Collection">
            {collectionFilters.map((c) => {
              const href = storeHref({ collection: c.id });
              const active = collectionParam === c.id;
              return (
                <a
                  href={href}
                  role="tab"
                  aria-selected={active}
                  class:list={[
                    "px-3 sm:px-4 py-2 text-[0.72rem] font-semibold tracking-[0.1em] uppercase transition-colors whitespace-nowrap border-[3px] border-ink",
                    active
                      ? "bg-ink text-paper"
                      : "bg-paper text-ink-2 hover:bg-secondary hover:text-paper",
                  ]}
                >
                  {c.label}
                </a>
              );
            })}
          </div>
        </div>

        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-[0.65rem] font-semibold tracking-[0.14em] uppercase text-muted mb-2">
              Product type
            </p>
            <div class="flex flex-wrap gap-2" role="tablist" aria-label="Product type">
              <a
                href={storeHref({ cat: "all" })}
                role="tab"
                aria-selected={catParam === "all"}
                class:list={[
                  "px-3 sm:px-4 py-2 text-[0.72rem] font-semibold tracking-[0.1em] uppercase transition-colors whitespace-nowrap border-[3px] border-ink",
                  catParam === "all"
                    ? "bg-ink text-paper"
                    : "bg-paper text-ink-2 hover:bg-secondary hover:text-paper",
                ]}
              >
                All types
              </a>
              {productTypes.map((id) => {
                const href = storeHref({ cat: id });
                const active = catParam === id;
                return (
                  <a
                    href={href}
                    role="tab"
                    aria-selected={active}
                    class:list={[
                      "px-3 sm:px-4 py-2 text-[0.72rem] font-semibold tracking-[0.1em] uppercase transition-colors whitespace-nowrap border-[3px] border-ink",
                      active
                        ? "bg-ink text-paper"
                        : "bg-paper text-ink-2 hover:bg-secondary hover:text-paper",
                    ]}
                  >
                    {categoryLabels[id] || id}
                  </a>
                );
              })}
            </div>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <p class="text-sm font-mono text-muted">{countLabel}</p>
            <label class="sr-only" for="sort">Sort</label>
            <select
              id="sort"
              class="border-[3px] border-ink bg-paper px-4 py-2 text-sm text-ink focus:border-accent focus:outline-none"
              onchange={`location.href='${storeHref({ sort: "__SORT__" })}'.replace('__SORT__',this.value)`}
            >
              <option value="featured" selected={sortParam === "featured"}>Featured</option>
              <option value="price-asc" selected={sortParam === "price-asc"}>Price: Low to high</option>
              <option value="price-desc" selected={sortParam === "price-desc"}>Price: High to low</option>
              <option value="name" selected={sortParam === "name"}>Name A–Z</option>
            </select>
          </div>
        </div>
      </div>

      {filtered.length === 0 ? (
        <div class="py-20 text-center">
          <p class="text-lg font-display text-ink">Nothing matches these filters yet</p>
          <a href="/store" class="mt-4 inline-block text-accent underline">View all products</a>
          {collectionParam !== "all" && (
            <a
              href={collectionPath(collectionParam)}
              class="mt-2 block text-accent underline"
            >
              Browse {activeCollection?.title || collectionParam} collection
            </a>
          )}
        </div>
      ) : (
        <div class="mt-8 grid gap-4 sm:gap-5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {filtered.map((p, i) => (
            <ProductCard product={p} priority={i < 4} index={i} />
          ))}
        </div>
      )}

      <div class="mt-14 border-[3px] border-ink bg-paper-2 p-8 md:p-10 md:flex md:items-center md:justify-between gap-6">
        <div>
          <h2 class="font-display text-xl text-ink">Not sure about sizing?</h2>
          <p class="mt-2 text-sm text-ink-2 max-w-md normal-case tracking-normal font-normal">
            Unisex fits with room to move. Size guides live on every product page — when in doubt, size up.
          </p>
        </div>
        <a href="/shipping-returns" class="btn btn--ink mt-4 md:mt-0 shrink-0">
          Shipping & returns
        </a>
      </div>
    </section>
  )}
</Layout>
