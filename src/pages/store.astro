---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/ProductCard.astro";
import TrustBar from "@/components/TrustBar.astro";
import { listProducts } from "@/lib/medusa";
import { mapProduct, categoryLabels, type FloofProduct } from "@/lib/product";

export const prerender = false;

const catParam = Astro.url.searchParams.get("cat") || "all";
const sortParam = Astro.url.searchParams.get("sort") || "featured";

let all: FloofProduct[] = [];
try {
  const { products } = await listProducts();
  all = products.map(mapProduct);
} catch {}

const categories = [
  { id: "all", label: "All" },
  ...Object.entries(categoryLabels).map(([id, label]) => ({ id, label })),
].filter((c) => c.id === "all" || all.some((p) => p.category === c.id));

let filtered =
  catParam === "all" ? all : all.filter((p) => p.category === catParam);

if (sortParam === "price-asc") {
  filtered = [...filtered].sort((a, b) => a.price - b.price);
} else if (sortParam === "price-desc") {
  filtered = [...filtered].sort((a, b) => b.price - a.price);
} else if (sortParam === "name") {
  filtered = [...filtered].sort((a, b) => a.name.localeCompare(b.name));
}

const countLabel =
  filtered.length === 1 ? "1 piece" : `${filtered.length} pieces`;
---
<Layout
  title={catParam !== "all" ? categoryLabels[catParam] || "Shop" : "Shop"}
  description="Browse Floof tees, hoodies, and more — witty SW Florida apparel, printed fresh when you order."
>
  <section class="page-band">
    <div class="mx-auto max-w-7xl px-5 md:px-6 py-12 md:py-16">
      <p class="eyebrow">Shop · inventory</p>
      <h1 class="mt-2 font-display text-4xl md:text-5xl text-ink">
        The Collection
      </h1>
      <p class="mt-3 text-ink-2 text-sm md:text-base max-w-xl normal-case tracking-normal font-normal">
        Soft blanks, sharp wit. Pick a size — we print it fresh.
      </p>
    </div>
  </section>

  <TrustBar compact />

  {all.length === 0 && (
    <div class="mx-auto max-w-2xl px-6 py-20 text-center">
      <p class="font-display text-2xl text-ink">No products yet</p>
      <p class="mt-3 text-ink-2 normal-case tracking-normal font-normal">Check back soon — new drops are on the way.</p>
    </div>
  )}

  {all.length > 0 && (
    <section class="mx-auto max-w-7xl px-5 md:px-6 py-10 md:py-12">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b-[3px] border-ink pb-6">
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Category">
          {categories.map((c) => {
            const href =
              c.id === "all"
                ? `/store?sort=${sortParam}`
                : `/store?cat=${c.id}&sort=${sortParam}`;
            const active = catParam === c.id;
            return (
              <a
                href={href}
                role="tab"
                aria-selected={active}
                class:list={[
                  "px-3 sm:px-4 py-2 text-[0.72rem] font-semibold tracking-[0.1em] uppercase transition-colors whitespace-nowrap border-[3px] border-ink",
                  active
                    ? "bg-ink text-paper"
                    : "bg-paper text-ink-2 hover:bg-secondary hover:text-paper",
                ]}
              >
                {c.label}
              </a>
            );
          })}
        </div>
        <div class="flex items-center gap-3">
          <p class="text-sm font-mono text-muted">{countLabel}</p>
          <label class="sr-only" for="sort">Sort</label>
          <select
            id="sort"
            class="border-[3px] border-ink bg-paper px-4 py-2 text-sm text-ink focus:border-accent focus:outline-none"
            onchange={`const cat='${catParam}'; const v=this.value; location.href='/store'+(cat!=='all'?'?cat='+cat+'&sort='+v:'?sort='+v)`}
          >
            <option value="featured" selected={sortParam === "featured"}>Featured</option>
            <option value="price-asc" selected={sortParam === "price-asc"}>Price: Low to high</option>
            <option value="price-desc" selected={sortParam === "price-desc"}>Price: High to low</option>
            <option value="name" selected={sortParam === "name"}>Name A–Z</option>
          </select>
        </div>
      </div>

      {filtered.length === 0 ? (
        <div class="py-20 text-center">
          <p class="text-lg font-display text-ink">Nothing in this category yet</p>
          <a href="/store" class="mt-4 inline-block text-accent underline">View all products</a>
        </div>
      ) : (
        <div class="mt-8 grid gap-4 sm:gap-5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {filtered.map((p, i) => (
            <ProductCard product={p} priority={i < 4} index={i} />
          ))}
        </div>
      )}

      <div class="mt-14 border-[3px] border-ink bg-paper-2 p-8 md:p-10 md:flex md:items-center md:justify-between gap-6">
        <div>
          <h2 class="font-display text-xl text-ink">Not sure about sizing?</h2>
          <p class="mt-2 text-sm text-ink-2 max-w-md normal-case tracking-normal font-normal">
            Unisex fits with room to move. Size guides live on every product page — when in doubt, size up.
          </p>
        </div>
        <a href="/shipping-returns" class="btn btn--ink mt-4 md:mt-0 shrink-0">
          Shipping & returns
        </a>
      </div>
    </section>
  )}
</Layout>
