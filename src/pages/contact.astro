---
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
---
<Layout title="Contact" description="Get in touch with Floof.">
  <section class="page-band">
    <div class="mx-auto max-w-3xl px-5 md:px-6 py-14 text-center">
      <p class="eyebrow">Hello</p>
      <h1 class="mt-2 font-display text-4xl md:text-5xl text-ink">Hit us up</h1>
      <p class="mt-4 text-ink-2 normal-case tracking-normal font-normal">Questions, collab ideas, or just want to say hi?</p>
    </div>
  </section>
  <div class="mx-auto max-w-2xl px-5 md:px-6 py-16 grid sm:grid-cols-2 gap-4">
    <div class="text-center p-8 border-[3px] border-ink bg-paper-2 min-w-0">
      <span class="inline-flex h-12 w-12 items-center justify-center border-[3px] border-ink bg-accent text-accent-ink">
        <Icon name="spark" class="w-6 h-6" />
      </span>
      <p class="mt-3 font-semibold text-ink uppercase tracking-wide text-sm">Email</p>
      <a href="mailto:hello@floof.space" class="text-accent hover:underline text-sm normal-case tracking-normal break-all">hello@floof.space</a>
    </div>
    <div class="text-center p-8 border-[3px] border-ink min-w-0">
      <span class="inline-flex h-12 w-12 items-center justify-center border-[3px] border-ink bg-secondary text-paper">
        <Icon name="pin" class="w-6 h-6" />
      </span>
      <p class="mt-3 font-semibold text-ink uppercase tracking-wide text-sm">Location</p>
      <p class="text-ink-2 text-sm normal-case tracking-normal font-normal">Southwest Florida</p>
    </div>
  </div>
</Layout>
