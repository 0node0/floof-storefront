---
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Terms of Service">
  <div class="mx-auto max-w-3xl px-5 md:px-6 py-16">
    <p class="eyebrow">Legal</p>
    <h1 class="mt-2 font-display text-3xl text-ink">Terms of Service</h1>
    <p class="mt-2 text-sm text-muted normal-case tracking-normal font-normal">Last updated: June 2026</p>
    <div class="mt-8 space-y-4 sm:space-y-6 text-ink-2 leading-relaxed normal-case tracking-normal font-normal">
      <section class="border-[3px] border-ink p-6 bg-paper-2">
        <h2 class="font-display text-xl text-ink">Overview</h2>
        <p class="mt-3">By using floof.space, you agree to these terms.</p>
      </section>
      <section class="border-[3px] border-ink p-6">
        <h2 class="font-display text-xl text-ink">Products</h2>
        <p class="mt-3">All products are print-on-demand, fulfilled through Printful. Colors may vary slightly from what you see on screen.</p>
      </section>
      <section class="border-[3px] border-ink p-6">
        <h2 class="font-display text-xl text-ink">Orders & Shipping</h2>
        <p class="mt-3">Orders are typically produced and shipped within 5–10 business days. Shipping times vary by location.</p>
      </section>
      <section class="border-[3px] border-ink p-6">
        <h2 class="font-display text-xl text-ink">Returns</h2>
        <p class="mt-3">Not happy with your order? Reach out within 30 days and we'll make it right.</p>
      </section>
      <section class="border-[3px] border-ink p-6">
        <h2 class="font-display text-xl text-ink">Contact</h2>
        <p class="mt-3">Questions? Email <a href="mailto:hello@floof.space" class="text-accent hover:underline">hello@floof.space</a>.</p>
      </section>
    </div>
  </div>
</Layout>
