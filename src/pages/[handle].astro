---
import Layout from "@/layouts/Layout.astro";
import CollectionHero from "@/components/collection/CollectionHero.astro";
import CollectionCatalog from "@/components/collection/CollectionCatalog.astro";
import CollectionHabitatBand from "@/components/collection/CollectionHabitatBand.astro";
import CollectionReadsQuote from "@/components/collection/CollectionReadsQuote.astro";
import CollectionDeskWeek from "@/components/collection/CollectionDeskWeek.astro";
import CollectionFloridaFloofsTeaser from "@/components/collection/CollectionFloridaFloofsTeaser.astro";
import CollectionFloridaFloofsShore from "@/components/collection/CollectionFloridaFloofsShore.astro";
import TrustBar from "@/components/TrustBar.astro";
import {
  getCollectionByHandle,
  listProductsByCollection,
} from "@/lib/medusa";
import {
  availableProductTypes,
  filterByProductType,
} from "@/lib/collections";
import { filterByBreed } from "@/lib/dogBreeds";
import { filterFloridaFloofsByAnimal } from "@/lib/floridaFloofsProducts";
import {
  buildGoogleFontsHref,
  resolveCollectionTheme,
  themeStyleAttribute,
} from "@/lib/collectionThemes";
import { ogCollectionImageUrl } from "@/lib/og/socialUrl";
import { themeAwareHeroCopy } from "@/lib/themeHeroCopy";
import {
  mapProduct,
  sortFloofProducts,
  type FloofProduct,
} from "@/lib/product";
export const prerender = false;

const { handle } = Astro.params;
if (!handle) return Astro.redirect("/404");

const { collection } = await getCollectionByHandle(handle).catch(() => ({
  collection: undefined,
}));
if (!collection) return Astro.redirect("/404");

const theme = resolveCollectionTheme(collection);

const typeParam = Astro.url.searchParams.get("type") || "all";
const sortParam = Astro.url.searchParams.get("sort") || "featured";
const breedParam = Astro.url.searchParams.get("breed") || "all";
const animalParam = Astro.url.searchParams.get("animal") || "all";

let products: FloofProduct[] = [];
try {
  const { products: raw } = await listProductsByCollection(collection.id);
  products = raw.map(mapProduct);
} catch {}

const hero = themeAwareHeroCopy(collection, theme.id);
const typeOptions = availableProductTypes(products);
let filtered = filterByProductType(products, typeParam);
if (theme.id === "dogs") {
  filtered = filterByBreed(filtered, breedParam);
}
if (theme.id === "floridaFloofs") {
  filtered = filterFloridaFloofsByAnimal(filtered, animalParam);
}
filtered = sortFloofProducts(filtered, sortParam);

const countLabel =
  filtered.length === 1 ? "1 piece" : `${filtered.length} pieces`;

const basePath = `/${collection.handle}`;
const showTrustBar = theme.id === "floof";
---
<Layout
  title={hero.seoTitle}
  description={hero.seoDescription}
  image={ogCollectionImageUrl(
    collection.handle,
    collection.updated_at ?? collection.created_at
  )}
  imageAlt={`${collection.title} collection at Floof`}
  googleFontsHref={buildGoogleFontsHref(theme)}
  themeColor={theme.themeColor}
>
  <div
    class="collection-theme"
    data-collection-theme={theme.id}
    style={themeStyleAttribute(theme)}
  >
    <CollectionHero
      variant={theme.heroVariant}
      hero={hero}
      assets={theme.hero}
      productCount={products.length}
    />

    {showTrustBar && <TrustBar compact />}

    {theme.id === "floridaFloofs" && products.length === 0 ? (
      <CollectionFloridaFloofsTeaser />
    ) : (
      <CollectionCatalog
        variant={theme.cardVariant}
        products={products}
        filtered={filtered}
        typeParam={typeParam}
        sortParam={sortParam}
        breedParam={breedParam}
        animalParam={animalParam}
        typeOptions={typeOptions}
        basePath={basePath}
        collectionTitle={hero.title}
        countLabel={countLabel}
      />
    )}

    {theme.id === "dogs" && <CollectionHabitatBand theme={theme.id} />}
    {theme.id === "reads" && <CollectionReadsQuote />}
    {theme.id === "desk" && <CollectionDeskWeek />}
    {theme.id === "floridaFloofs" && <CollectionFloridaFloofsShore />}
  </div>
</Layout>
