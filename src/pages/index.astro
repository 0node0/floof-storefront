---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/ProductCard.astro";
import TrustBar from "@/components/TrustBar.astro";
import Icon from "@/components/Icon.astro";
import { listProducts } from "@/lib/medusa";
import { mapProduct, type FloofProduct } from "@/lib/product";

export const prerender = false;

let products: FloofProduct[] = [];
try {
  const { products: raw } = await listProducts();
  products = raw.map(mapProduct).slice(0, 8);
} catch {}

const ogImage = products[0]?.image || "/favicon.svg";
const cats: { href: string; label: string; icon: string; blurb: string; tint: string }[] = [
  { href: "/store?cat=tees", label: "T-Shirts", icon: "shirt", blurb: "Soft everyday tees", tint: "bg-floof-yellow/25" },
  { href: "/store?cat=hoodies", label: "Hoodies", icon: "hoodie", blurb: "For cooler Gulf nights", tint: "bg-floof-ocean/12" },
  { href: "/store", label: "Full shop", icon: "spark", blurb: "Browse the collection", tint: "bg-floof-pink/12" },
];
const heroImg = products[0]?.image;
---
<Layout
  title="Witty apparel from the Gulf Coast"
  description="Floof is a Southwest Florida clothing brand — witty tees and hoodies, printed fresh when you order. Small drops, soft blanks, no deadstock."
  image={ogImage}
>
  {/* Photographic fold — Gulf Coast boutique */}
  <section class="relative overflow-hidden sun-wash">
    <div class="relative mx-auto max-w-7xl px-6 py-16 md:py-24 lg:py-28">
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6 xl:col-span-5">
          <p class="eyebrow">Southwest Florida · printed to order</p>
          <h1 class="mt-4 font-display text-[clamp(2.5rem,5vw+0.5rem,4rem)] font-semibold text-floof-dark leading-[1.05]">
            Life&rsquo;s too short for{" "}
            <span class="text-floof-gradient">boring clothes.</span>
          </h1>
          <p class="mt-6 text-lg text-floof-dark/60 max-w-md leading-relaxed">
            Witty threads with Gulf Coast ease — designed for people who smile at the joke and still care how it wears.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/store" class="btn btn--lg">
              Shop the collection
            </a>
            <a href="/about" class="btn btn--outline btn--lg">
              Our story
            </a>
          </div>
          <dl class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-floof-dark/50">
            <div class="inline-flex items-center gap-2">
              <Icon name="truck" class="w-4 h-4 text-floof-coral" />
              <dd>Free ship $75+</dd>
            </div>
            <div class="inline-flex items-center gap-2">
              <Icon name="pin" class="w-4 h-4 text-floof-coral" />
              <dd>Printed in the US</dd>
            </div>
            <div class="inline-flex items-center gap-2">
              <Icon name="return" class="w-4 h-4 text-floof-coral" />
              <dd>30-day returns</dd>
            </div>
          </dl>
        </div>
        <div class="lg:col-span-6 xl:col-span-7">
          <div class="relative mx-auto max-w-lg lg:max-w-none">
            <div class="aspect-[4/5] sm:aspect-square rounded-[1.25rem] bg-white/80 p-6 md:p-10 shadow-[0_20px_50px_-20px_oklch(22%_0.02_50_/_0.18)] outline outline-1 outline-floof-dark/6 flex items-center justify-center overflow-hidden">
              {heroImg ? (
                <img
                  src={heroImg}
                  alt="Featured Floof apparel"
                  class="w-full h-full object-contain"
                  width="560"
                  height="560"
                  loading="eager"
                />
              ) : (
                <p class="font-display text-3xl md:text-4xl text-floof-dark/25 text-center px-6 font-semibold">
                  Soft blanks.<br />Sharp wit.
                </p>
              )}
            </div>
            <div class="absolute -bottom-3 left-4 rounded-full bg-floof-dark text-floof-cream px-4 py-2 text-[11px] font-mono font-medium uppercase tracking-[0.12em] shadow-md">
              Made to order
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <TrustBar />

  <section class="mx-auto max-w-7xl px-6 py-14">
    <div class="mb-8 max-w-xl">
      <p class="eyebrow">Shop</p>
      <h2 class="mt-2 font-display text-2xl md:text-3xl font-semibold text-floof-dark">Find your fit</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-3">
      {cats.map((c) => (
        <a
          href={c.href}
          class="card-surface group block p-8 text-left"
        >
          <span class:list={["inline-flex h-12 w-12 items-center justify-center rounded-2xl text-floof-dark group-hover:scale-105 transition-transform", c.tint]}>
            <Icon name={c.icon} class="w-6 h-6" />
          </span>
          <p class="mt-4 font-display text-lg font-semibold text-floof-dark group-hover:text-floof-pink transition-colors">{c.label}</p>
          <p class="mt-1 text-sm text-floof-dark/50">{c.blurb}</p>
        </a>
      ))}
    </div>
  </section>

  {products.length > 0 && (
    <section class="border-y border-floof-dark/5 bg-floof-sand/50">
      <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
        <div class="flex items-end justify-between gap-4 mb-10">
          <div>
            <p class="eyebrow">Collection</p>
            <h2 class="mt-2 font-display text-3xl font-semibold md:text-4xl text-floof-dark">Selected pieces</h2>
          </div>
          <a href="/store" class="text-sm font-semibold text-floof-pink underline underline-offset-4 shrink-0">View all</a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {products.slice(0, 4).map((p, i) => <ProductCard product={p} priority={i < 2} />)}
        </div>
        {products.length > 4 && (
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {products.slice(4, 8).map((p) => <ProductCard product={p} />)}
          </div>
        )}
      </div>
    </section>
  )}

  {products.length === 0 && (
    <section class="mx-auto max-w-3xl px-6 py-20 text-center">
      <p class="font-display text-2xl font-semibold text-floof-dark">New pieces are on the way.</p>
      <p class="mt-2 text-floof-dark/50">Check back soon for the next drop.</p>
    </section>
  )}

  <section class="relative overflow-hidden">
    <div class="absolute inset-0 sun-wash opacity-70" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-3xl px-6 py-20 text-center">
      <p class="eyebrow">Why Floof</p>
      <h2 class="mt-3 font-display text-2xl md:text-3xl font-semibold text-floof-dark leading-snug">
        Soft blanks. Sharp wit.<br class="hidden sm:block" /> Printed when you order.
      </h2>
      <p class="mt-4 text-floof-dark/55 leading-relaxed max-w-xl mx-auto">
        Designed in Southwest Florida, made to order in the US. Better for small drops — and better than piles of deadstock waiting to go out of fashion.
      </p>
      <a href="/store" class="btn btn--lg mt-8">
        Shop now
      </a>
    </div>
  </section>
</Layout>
