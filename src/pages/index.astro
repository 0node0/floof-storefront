---
import Layout from "@/layouts/Layout.astro";
import ProductCard from "@/components/ProductCard.astro";
import TrustBar from "@/components/TrustBar.astro";
import Icon from "@/components/Icon.astro";
import { listProducts } from "@/lib/medusa";
import { mapProduct, type FloofProduct } from "@/lib/product";

export const prerender = false;

let products: FloofProduct[] = [];
try {
  const { products: raw } = await listProducts();
  products = raw.map(mapProduct).slice(0, 8);
} catch {}

const ogImage = products[0]?.image || "/favicon.svg";
const heroImg = products[0]?.image;

const manifesto = [
  { n: "01", line: "No warehouse dust.", tag: "print on demand" },
  { n: "02", line: "Soft blanks. Sharp wit.", tag: "product" },
  { n: "03", line: "Designed in SW Florida.", tag: "origin" },
  { n: "04", line: "Made when you order.", tag: "fulfillment" },
  { n: "05", line: "Life's too short for boring clothes.", tag: "thesis" },
];

const cats: { href: string; label: string; icon: string; blurb: string }[] = [
  { href: "/store?cat=tees", label: "T-Shirts", icon: "shirt", blurb: "Soft everyday tees" },
  { href: "/store?cat=hoodies", label: "Hoodies", icon: "hoodie", blurb: "For cooler Gulf nights" },
  { href: "/store", label: "Full shop", icon: "spark", blurb: "Browse the press" },
];
---
<Layout
  title="Ink first. Clothes second."
  description="Floof is a Southwest Florida clothing brand — witty tees and hoodies, printed fresh when you order. Soft blanks, sharp wit, no deadstock."
  image={ogImage}
>
  {/* Poster hero */}
  <section class="relative overflow-hidden border-b-[3px] border-ink">
    <div class="grid lg:grid-cols-12 min-h-[min(88vh,52rem)]">
      <div class="lg:col-span-7 flex flex-col justify-between p-6 md:p-10 lg:p-12 border-b-[3px] lg:border-b-0 lg:border-r-[3px] border-ink sun-wash">
        <div>
          <p class="eyebrow">
            <span class="text-accent font-semibold">Press run</span>
            <span class="text-ink-2"> · SWFL · POD · small drops</span>
          </p>
          <h1 class="mt-5 font-display text-[clamp(3rem,10vw,6.5rem)] text-ink leading-[0.88]">
            Ink first.<br />
            <span class="text-accent">Clothes second.</span>
          </h1>
          <p class="mt-6 text-base md:text-lg text-ink-2 max-w-md leading-relaxed normal-case tracking-normal font-normal">
            Witty apparel from the Gulf Coast — set like a zine cover, sold as limited runs. Soft blanks. Sharp wit. Printed when you order.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/store" class="btn btn--lg">Enter the shop</a>
            <a href="/about" class="btn btn--outline btn--lg">Our story</a>
          </div>
        </div>
        <dl class="mt-10 grid grid-cols-3 border-t-[3px] border-ink">
          <div class="pt-4 pr-3 border-r-[3px] border-ink">
            <dt class="text-[0.65rem] tracking-[0.14em] uppercase text-muted">Format</dt>
            <dd class="mt-1 font-display text-sm md:text-base text-ink">Made to order</dd>
          </div>
          <div class="pt-4 px-3 border-r-[3px] border-ink">
            <dt class="text-[0.65rem] tracking-[0.14em] uppercase text-muted">Origin</dt>
            <dd class="mt-1 font-display text-sm md:text-base text-ink">Gulf Coast</dd>
          </div>
          <div class="pt-4 pl-3">
            <dt class="text-[0.65rem] tracking-[0.14em] uppercase text-muted">Ship</dt>
            <dd class="mt-1 font-display text-sm md:text-base text-ink">Free $75+</dd>
          </div>
        </dl>
      </div>
      <div class="lg:col-span-5 relative flex items-center justify-center p-6 md:p-10 bg-paper-2">
        <div class="absolute top-4 right-4 w-20 h-20 border-[3px] border-accent rounded-full grid place-items-center text-center text-[0.55rem] font-semibold tracking-[0.08em] uppercase leading-snug text-accent rotate-12 bg-paper/60">
          Printed<br />fresh<br />not stocked
        </div>
        <div class="relative w-full max-w-md aspect-[4/5] bg-cream border-[3px] border-ink shadow-[12px_12px_0_0_var(--color-secondary)] flex items-center justify-center p-6 md:p-8 overflow-hidden">
          {heroImg ? (
            <img
              src={heroImg}
              alt="Featured Floof apparel"
              class="w-full h-full object-contain"
              width="560"
              height="700"
              loading="eager"
            />
          ) : (
            <p class="font-display text-3xl md:text-4xl text-paper text-center leading-[0.95]">
              Soft blanks.<br />Sharp wit.
            </p>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="home-manifesto" aria-labelledby="house-rules">
    <div class="home-manifesto__head">
      <span id="house-rules">House rules</span>
      <span>Five lines · no fluff</span>
    </div>
    <ol class="home-manifesto__list">
      {manifesto.map((item) => (
        <li>
          <span class="n">{item.n}</span>
          <span>{item.line}</span>
          <span class="tag">{item.tag}</span>
        </li>
      ))}
    </ol>
  </section>

  <TrustBar />

  <section class="border-b-[3px] border-ink">
    <div class="mx-auto max-w-7xl px-5 md:px-6 py-12">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Shop</p>
          <h2 class="mt-2 font-display text-3xl md:text-4xl text-ink">Find your fit</h2>
        </div>
      </div>
      <div class="grid gap-0 sm:grid-cols-3 border-[3px] border-ink">
        {cats.map((c, i) => (
          <a
            href={c.href}
            class:list={[
              "group block p-8 bg-paper hover:bg-paper-2 transition-colors",
              i < 2 && "border-b-[3px] sm:border-b-0 sm:border-r-[3px] border-ink",
            ]}
          >
            <span class="inline-flex h-12 w-12 items-center justify-center border-[3px] border-ink bg-accent text-accent-ink group-hover:bg-secondary transition-colors">
              <Icon name={c.icon} class="w-6 h-6" />
            </span>
            <p class="mt-4 font-display text-xl text-ink group-hover:text-accent transition-colors">{c.label}</p>
            <p class="mt-1 text-sm text-ink-2 normal-case tracking-normal font-normal">{c.blurb}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {products.length > 0 && (
    <section class="border-b-[3px] border-ink">
      <div class="flex flex-wrap items-end justify-between gap-4 px-5 md:px-6 py-8 border-b-[3px] border-ink bg-paper-2">
        <div>
          <p class="eyebrow">Collection</p>
          <h2 class="mt-2 font-display text-3xl md:text-4xl text-ink">Current press</h2>
          <p class="mt-2 text-sm text-ink-2 max-w-md normal-case tracking-normal font-normal">
            Scroll the strip — restaged as a lookbook rail.
          </p>
        </div>
        <a href="/store" class="text-[0.72rem] font-semibold tracking-[0.12em] uppercase text-secondary border-b-2 border-secondary hover:text-accent hover:border-accent pb-0.5">
          Full inventory →
        </a>
      </div>
      <div class="lookbook-rail" role="list">
        {products.map((p, i) => (
          <div role="listitem">
            <ProductCard product={p} priority={i < 2} index={i} />
          </div>
        ))}
      </div>
    </section>
  )}

  {products.length === 0 && (
    <section class="mx-auto max-w-3xl px-6 py-20 text-center border-b-[3px] border-ink">
      <p class="font-display text-2xl text-ink">New pieces are on the way.</p>
      <p class="mt-2 text-ink-2 normal-case tracking-normal font-normal">The press is warming up.</p>
    </section>
  )}

  <section class="grid md:grid-cols-2 border-b-[3px] border-ink">
    <div class="p-8 md:p-12 border-b-[3px] md:border-b-0 md:border-r-[3px] border-ink">
      <h2 class="font-display text-2xl md:text-3xl text-ink">Why Floof</h2>
      <p class="mt-4 text-ink-2 leading-relaxed max-w-md normal-case tracking-normal font-normal">
        Designed in Southwest Florida, made to order in the US. Better for small drops — and better than piles of deadstock waiting to go out of fashion.
      </p>
      <a href="/about" class="btn btn--outline mt-8">Read the story</a>
    </div>
    <div class="p-8 md:p-12 bg-accent text-accent-ink">
      <h2 class="font-display text-2xl md:text-3xl">Ready to wear it?</h2>
      <p class="mt-4 leading-relaxed max-w-md normal-case tracking-normal font-normal opacity-80">
        Checkout, shipping, and returns are the real system. Pick a size and we print it.
      </p>
      <a href="/store" class="btn btn--ghost-light mt-8">Shop the collection</a>
    </div>
  </section>
</Layout>
