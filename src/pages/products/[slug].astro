---
import Layout from "@/layouts/Layout.astro";
import ReactiveCartIsland from "@/components/ReactiveCartIsland";
import ProductGallery from "@/components/ProductGallery";
import ProductCard from "@/components/ProductCard.astro";
import ProductJsonLd from "@/components/ProductJsonLd.astro";
import ThemedProductMedia from "@/components/product/ThemedProductMedia.astro";
import TrustBar from "@/components/TrustBar.astro";
import { listProducts, getProductWithRetry } from "@/lib/medusa";
import { productCarePanel } from "@/lib/productCare";
import type { MedusaVariant } from "@/lib/medusa";
import { mapProduct, categoryLabels, type FloofProduct } from "@/lib/product";
import {
  buildGoogleFontsHref,
  themeStyleAttribute,
} from "@/lib/collectionThemes";
import { productGalleryImages } from "@/lib/productCard";
import {
  productPageThemeBundle,
  relatedProductsForShelf,
  resolveProductPageTheme,
} from "@/lib/productPageTheme";
import { site } from "@/lib/site";
import { formatPrice } from "@/lib/formatPrice";
import { ogProductImageUrl } from "@/lib/og/socialUrl";

export const prerender = false;

const { slug } = Astro.params;

let product: FloofProduct | null = null;
let variants: MedusaVariant[] = [];
let image = "/favicon.svg";
let related: FloofProduct[] = [];
let allProducts: FloofProduct[] = [];

const handle = slug || "";
const { product: raw, fetchFailed } = await getProductWithRetry(handle);

if (fetchFailed) {
  return Astro.redirect(
    `/products/unavailable?slug=${encodeURIComponent(handle)}`
  );
}

if (!raw) return Astro.redirect("/404");

product = mapProduct(raw);
variants = raw.variants || [];
image = product.image || "/favicon.svg";

try {
  const { products } = await listProducts();
  allProducts = products.map(mapProduct);
} catch {}

if (!product) return Astro.redirect("/404");

const carePanel = productCarePanel(product);

const fromParam = Astro.url.searchParams.get("from");
const pageTheme = resolveProductPageTheme(fromParam, product);
const theme = productPageThemeBundle(pageTheme.themeId);
const isThemed = pageTheme.themeId !== "floof";

if (pageTheme.themeId === "reads") {
  await import("@/styles/collection-fonts-reads.css");
}

related = relatedProductsForShelf(
  allProducts,
  product,
  pageTheme.themeId,
  pageTheme.collectionHandle
);

const ogImage = ogProductImageUrl(product);
const ogImageAlt = `${product.name} — ${formatPrice(Math.round(product.price * 100))} at Floof`;
const catLabel = categoryLabels[product.category] || product.category;
const collectionHref = pageTheme.collectionHandle
  ? `/${pageTheme.collectionHandle}`
  : product.collectionHandle
    ? `/${product.collectionHandle}`
    : `/store?type=${product.category}`;
const collectionCrumbLabel = pageTheme.collectionLabel || catLabel;
const galleryImages = productGalleryImages(product);

const canonicalHref = new URL(`/products/${slug}`, site.url).href;
const cardVariant = isThemed ? pageTheme.themeId : "floof";
---

<Layout
  title={product.name}
  description={product.description || `Shop ${product.name} from Floof.`}
  image={ogImage}
  imageAlt={ogImageAlt}
  googleFontsHref={buildGoogleFontsHref(theme)}
  themeColor={theme.themeColor}
  canonicalHref={canonicalHref}
>
  <ProductJsonLd product={product} />

  {isThemed ? (
    <div
      class="collection-theme product-pdp-theme"
      data-collection-theme={pageTheme.themeId}
      style={themeStyleAttribute(theme)}
    >
      <article class="product-pdp">
        <nav class="product-pdp__crumbs" aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-1 list-none p-0 m-0">
            <li><a href="/">Home</a></li>
            <li aria-hidden="true" class="mx-1 opacity-40">/</li>
            <li><a href="/store">Shop</a></li>
            <li aria-hidden="true" class="mx-1 opacity-40">/</li>
            <li><a href={collectionHref}>{collectionCrumbLabel}</a></li>
            <li aria-hidden="true" class="mx-1 opacity-40">/</li>
            <li aria-current="page" class="truncate max-w-[14rem] sm:max-w-none">{product.name}</li>
          </ol>
        </nav>

        <div class="product-pdp__grid">
          <ThemedProductMedia
            themeId={pageTheme.themeId}
            images={galleryImages}
            productName={product.name}
            phrase={product.phrase}
            price={product.price}
          />

          <div class="product-pdp__panel">
            {product.isWip && (
              <span class="inline-flex w-fit px-3 py-1 text-xs font-mono font-semibold uppercase tracking-wider bg-accent text-accent-ink border mb-3">
                Design preview
              </span>
            )}
            <p class="product-pdp__eyebrow">{catLabel}</p>
            <h1 class="product-pdp__title">{product.name}</h1>
            <p class="product-pdp__lede">{product.description}</p>

            <div class="product-pdp-cart">
              {variants.length > 0 ? (
                <ReactiveCartIsland client:load product={product} variants={variants} />
              ) : (
                <p class="mt-8 text-sm text-muted">Variants syncing — check back shortly.</p>
              )}
            </div>

            <div class="product-pdp__accordions mt-10 border-t border-ink/20">
              <details class="group border-b border-ink/20" open>
                <summary class="flex cursor-pointer list-none items-center justify-between font-semibold py-4 text-sm tracking-wide">
                  Shipping & fulfillment
                  <span class="text-muted group-open:rotate-180 transition-transform inline-block" aria-hidden="true">▾</span>
                </summary>
                <div class="pb-4 text-sm text-ink-2 space-y-2 leading-relaxed normal-case tracking-normal font-normal">
                  <p>Printed on demand in the US when you order — usually ships within 2–7 business days after production.</p>
                  <p><strong class="text-ink">Free standard shipping</strong> on orders $75+ (US).</p>
                  <p><a href="/shipping-returns" class="text-accent underline">Full shipping & returns policy</a></p>
                </div>
              </details>
              {carePanel.show && (
                <details class="group border-b border-ink/20">
                  <summary class="flex cursor-pointer list-none items-center justify-between font-semibold py-4 text-sm tracking-wide">
                    {carePanel.title}
                    <span class="text-muted group-open:rotate-180 transition-transform inline-block" aria-hidden="true">▾</span>
                  </summary>
                  <div class="pb-4 text-sm text-ink-2 space-y-2 leading-relaxed">
                    {carePanel.paragraphs.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </details>
              )}
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between font-semibold py-4 text-sm tracking-wide">
                  Returns
                  <span class="text-muted group-open:rotate-180 transition-transform inline-block" aria-hidden="true">▾</span>
                </summary>
                <div class="pb-4 text-sm text-ink-2 space-y-2 leading-relaxed">
                  <p>30 days on unworn items with tags. Because items are made to order, please double-check size before checkout.</p>
                </div>
              </details>
            </div>
          </div>
        </div>
      </article>

      {related.length > 0 && (
        <section class="product-pdp__related" aria-labelledby="related-shelf-title">
          <div class="product-pdp__related-head">
            <div>
              <p class="product-pdp__eyebrow">{pageTheme.shelfEyebrow}</p>
              <h2 id="related-shelf-title" class="mt-1">{pageTheme.shelfHeading}</h2>
            </div>
            <a href={collectionHref} class="product-pdp__related-link shrink-0">Back to shelf</a>
          </div>
          <div
            class:list={[
              "grid gap-4 sm:gap-7 grid-cols-2 lg:grid-cols-4",
              "collection-product-grid",
              `collection-product-grid--${cardVariant}`,
            ]}
          >
            {related.map((p, i) => (
              <ProductCard
                product={p}
                index={i}
                variant={cardVariant}
                linkFrom={cardVariant}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  ) : (
    <>
      <div class="mx-auto max-w-7xl px-5 md:px-6 py-8 md:py-12">
        <nav class="mb-8 text-xs font-medium tracking-[0.1em] uppercase text-muted" aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-1">
            <li><a href="/" class="hover:text-accent">Home</a></li>
            <li aria-hidden="true" class="mx-1 text-ink/20">/</li>
            <li><a href="/store" class="hover:text-accent">Shop</a></li>
            <li aria-hidden="true" class="mx-1 text-ink/20">/</li>
            <li><a href={collectionHref} class="hover:text-accent">{collectionCrumbLabel}</a></li>
            <li aria-hidden="true" class="mx-1 text-ink/20">/</li>
            <li class="text-ink truncate max-w-[12rem] sm:max-w-none normal-case tracking-normal">{product.name}</li>
          </ol>
        </nav>

        <div class="grid gap-4 lg:gap-6 lg:grid-cols-2 min-w-0">
          <ProductGallery
            client:load
            images={galleryImages}
            alt={`${product.name} product photo`}
            phrase={product.phrase}
          />

          <div class="flex flex-col p-5 sm:p-6 md:p-10 bg-paper border-[3px] border-ink min-w-0">
            {product.isWip && (
              <span class="inline-flex w-fit px-3 py-1 text-xs font-mono font-semibold uppercase tracking-wider bg-accent text-accent-ink border-[3px] border-ink mb-3">
                Design preview
              </span>
            )}
            <p class="eyebrow">{catLabel}</p>
            <h1 class="mt-2 font-display text-3xl md:text-4xl text-ink leading-tight">{product.name}</h1>
            <p class="mt-4 text-base md:text-lg text-ink-2 leading-relaxed normal-case tracking-normal font-normal">{product.description}</p>

            {variants.length > 0 ? (
              <ReactiveCartIsland client:load product={product} variants={variants} />
            ) : (
              <p class="mt-8 text-sm text-muted">Variants syncing — check back shortly.</p>
            )}

            <div class="mt-10 border-t-[3px] border-ink">
              <details class="group border-b-[3px] border-ink" open>
                <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-ink py-4 uppercase tracking-wide text-sm">
                  Shipping & fulfillment
                  <span class="text-muted group-open:rotate-180 transition-transform inline-block">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M5 7l4 4 4-4"/></svg>
                  </span>
                </summary>
                <div class="pb-4 text-sm text-ink-2 space-y-2 leading-relaxed normal-case tracking-normal font-normal">
                  <p>Printed on demand in the US when you order — usually ships within 2–7 business days after production.</p>
                  <p><strong class="text-ink">Free standard shipping</strong> on orders $75+ (US).</p>
                  <p><a href="/shipping-returns" class="text-accent underline">Full shipping & returns policy</a></p>
                </div>
              </details>
              {carePanel.show && (
                <details class="group border-b-[3px] border-ink">
                  <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-ink py-4 uppercase tracking-wide text-sm">
                    {carePanel.title}
                    <span class="text-muted group-open:rotate-180 transition-transform inline-block">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M5 7l4 4 4-4"/></svg>
                    </span>
                  </summary>
                  <div class="pb-4 text-sm text-ink-2 space-y-2 leading-relaxed normal-case tracking-normal font-normal">
                    {carePanel.paragraphs.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </details>
              )}
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-ink py-4 uppercase tracking-wide text-sm">
                  Returns
                  <span class="text-muted group-open:rotate-180 transition-transform inline-block">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M5 7l4 4 4-4"/></svg>
                  </span>
                </summary>
                <div class="pb-4 text-sm text-ink-2 space-y-2 leading-relaxed normal-case tracking-normal font-normal">
                  <p>30 days on unworn items with tags. Because items are made to order, please double-check size before checkout.</p>
                </div>
              </details>
            </div>
          </div>
        </div>
      </div>

      <TrustBar compact />

      {related.length > 0 && (
        <section class="mx-auto max-w-7xl px-5 md:px-6 py-16">
          <div class="flex items-end justify-between gap-4 mb-8">
            <div>
              <p class="eyebrow">More from the press</p>
              <h2 class="mt-1 font-display text-2xl md:text-3xl text-ink">Related pieces</h2>
            </div>
            <a href="/store" class="text-[0.72rem] font-semibold tracking-[0.12em] uppercase text-accent underline underline-offset-4 shrink-0">Shop all</a>
          </div>
          <div class="grid gap-4 sm:gap-5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((p, i) => (
              <ProductCard product={p} index={i} />
            ))}
          </div>
        </section>
      )}
    </>
  )}
</Layout>
