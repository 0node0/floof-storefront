---
import Layout from "@/layouts/Layout.astro";
import { listCollections } from "@/lib/medusa";
import { parseStyleCollection } from "@/lib/style";
import { withUtm } from "@/lib/urls";

export const prerender = false;

const utmQuery = Astro.locals.utmQuery ?? "";

interface StyleCard {
  handle: string
  title: string
  tagline: string
  description: string
  accentColor?: string
}

let styles: StyleCard[] = [];
try {
  const { collections } = await listCollections();
  styles = collections
    .map((c) => {
      const landing = parseStyleCollection(c);
      return {
        handle: landing.handle,
        title: landing.title,
        tagline: landing.tagline,
        description: landing.description,
        accentColor: landing.accentColor,
      };
    })
    .sort((a, b) => a.title.localeCompare(b.title));
} catch {}
---
<Layout
  title="Styles"
  description="Explore Floof style collections — retro, minimal, cute, dark, and more. Each drop has its own aesthetic, printed fresh when you order."
>
  <section class="page-band border-b-[3px] border-ink">
    <div class="mx-auto max-w-7xl px-5 md:px-6 py-12 md:py-16">
      <p class="eyebrow">Shop · aesthetics</p>
      <h1 class="mt-2 font-display text-4xl md:text-5xl text-ink">Style collections</h1>
      <p class="mt-3 text-ink-2 text-sm md:text-base max-w-xl normal-case tracking-normal font-normal">
        Pick a vibe — each collection is its own landing page with pieces curated for that look.
      </p>
    </div>
  </section>

  {styles.length === 0 ? (
    <div class="mx-auto max-w-2xl px-6 py-20 text-center">
      <p class="font-display text-2xl text-ink">Styles on the way</p>
      <p class="mt-3 text-ink-2 normal-case tracking-normal font-normal">
        New aesthetic drops are setting up in the backend — the full shop is open meanwhile.
      </p>
      <a href={withUtm("/store", utmQuery)} class="mt-6 inline-block btn">Shop all</a>
    </div>
  ) : (
    <section class="mx-auto max-w-7xl px-5 md:px-6 py-10 md:py-14">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {styles.map((s) => (
          <a
            href={withUtm(`/s/${s.handle}`, utmQuery)}
            class="group block border-[3px] border-ink bg-paper hover:bg-paper-2 transition-colors overflow-hidden"
            style={s.accentColor ? `--color-accent: ${s.accentColor}` : undefined}
          >
            <div class="p-6 md:p-8 border-b-[3px] border-ink bg-paper-2 group-hover:bg-paper transition-colors">
              <p class="eyebrow text-accent">{s.tagline}</p>
              <h2 class="mt-2 font-display text-2xl text-ink group-hover:text-accent transition-colors">
                {s.title}
              </h2>
            </div>
            <p class="p-6 text-sm text-ink-2 leading-relaxed normal-case tracking-normal font-normal line-clamp-3">
              {s.description}
            </p>
            <p class="px-6 pb-6 text-[0.72rem] font-semibold tracking-[0.12em] uppercase text-secondary group-hover:text-accent">
              View collection →
            </p>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
