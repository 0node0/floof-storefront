---
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Privacy Policy">
  <div class="mx-auto max-w-3xl px-5 md:px-6 py-16">
    <p class="eyebrow">Legal</p>
    <h1 class="mt-2 font-display text-3xl text-ink">Privacy Policy</h1>
    <p class="mt-2 text-sm text-muted normal-case tracking-normal font-normal">Last updated: June 2026</p>
    <div class="mt-8 space-y-4 sm:space-y-6 text-ink-2 leading-relaxed normal-case tracking-normal font-normal">
      <section class="border-[3px] border-ink p-6 bg-paper-2">
        <h2 class="font-display text-xl text-ink">What We Collect</h2>
        <p class="mt-3">When you place an order, we collect your name, email, shipping address, and payment info. We also use cookies to improve your browsing experience.</p>
      </section>
      <section class="border-[3px] border-ink p-6">
        <h2 class="font-display text-xl text-ink">How We Use It</h2>
        <p class="mt-3">Your info is used to process orders, send shipping updates, and occasionally let you know about new drops (only if you opt in). We don't sell your data.</p>
      </section>
      <section class="border-[3px] border-ink p-6">
        <h2 class="font-display text-xl text-ink">Payment Processing</h2>
        <p class="mt-3">Payments are handled by Stripe. We never see or store your full credit card number.</p>
      </section>
      <section class="border-[3px] border-ink p-6">
        <h2 class="font-display text-xl text-ink">Fulfillment</h2>
        <p class="mt-3">Orders are fulfilled through Printful. Your shipping info is shared with them solely to deliver your order.</p>
      </section>
      <section class="border-[3px] border-ink p-6">
        <h2 class="font-display text-xl text-ink">Contact</h2>
        <p class="mt-3">Questions? Email <a href="mailto:hello@floof.space" class="text-accent hover:underline">hello@floof.space</a>.</p>
      </section>
    </div>
  </div>
</Layout>
