---
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";

export const prerender = false;
const { id } = Astro.params;
---
<Layout title={`Order ${id || ""}`} description="Thanks for your Floof order!" noIndex={true}>
  <section class="mx-auto max-w-2xl px-6 py-20 text-center">
    <span class="inline-flex h-16 w-16 items-center justify-center border-[3px] border-ink bg-secondary text-paper mb-6">
      <Icon name="check" class="w-8 h-8" size={32} />
    </span>
    <h1 class="font-display text-3xl text-ink">Thanks for your order!</h1>
    <p class="mt-4 text-lg text-ink-2 normal-case tracking-normal font-normal">
      Order <code class="bg-paper-2 border border-ink px-2 py-0.5 text-sm font-mono text-accent">{id}</code> has been placed.
    </p>
    <p class="mt-2 text-ink-2 normal-case tracking-normal font-normal">
      You&rsquo;ll receive a confirmation email with tracking info once it ships.
    </p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <a href="/store" class="btn">
        Continue shopping
      </a>
      <a href="/" class="btn btn--outline">
        Back to home
      </a>
    </div>
  </section>
</Layout>
